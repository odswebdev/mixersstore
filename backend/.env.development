# ========================
# ОКРУЖЕНИЕ
# ========================
NODE_ENV=development
PORT=5000
APP_NAME=Ecommerce Shop Dev
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api
NODE_OPTIONS=--max-old-space-size=4096

# ========================
# БАЗА ДАННЫХ PostgreSQL (локальная)
# ========================
# Локальный PostgreSQL (используйте Docker для простоты)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mixersstore_db
DB_USER=postgres
DB_PASSWORD=test2026
# Или через Docker (если используете docker-compose):
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=mixersstore_db
# DB_USER=postgres
# DB_PASSWORD=postgres123

# URL для подключения (для Sequelize)
DATABASE_URL=postgresql://postgres:test2026@localhost:5432/mixersstore_db

# ========================
# Neon.tech (альтернатива для тестирования)
# ========================
# Закомментируйте блок выше и раскомментируйте этот для Neon.tech:
# DB_HOST=ep-cool-sun-a2b3c4d5.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=nbn_1234567890abcdef
# DATABASE_URL=postgresql://neondb_owner:nbn_1234567890abcdef@ep-cool-sun-a2b3c4d5.us-east-2.aws.neon.tech/neondb?sslmode=require

# ========================
# БАЗА ДАННЫХ ДЛЯ ТЕСТОВ
# ========================
DB_TEST_NAME=mixersstore_test
DB_TEST_HOST=localhost
DB_TEST_PORT=5433

# ========================
# JWT АУТЕНТИФИКАЦИЯ
# ========================
JWT_SECRET=dev_super_secret_jwt_key_1234567890_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev_refresh_secret_key_1234567890_change_me
JWT_REFRESH_EXPIRES_IN=30d

# ========================
# КЛИЕНТСКИЕ НАСТРОЙКИ
# ========================
# Разрешенные домены для CORS
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080
# Основной клиентский URL (для ссылок в email)
FRONTEND_URL=http://localhost:5173

# ========================
# EMAIL НАСТРОЙКИ (разработка)
# ========================
# Mailtrap для тестирования email (бесплатный аккаунт)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=2a3b4c5d6e7f89
SMTP_PASS=1a2b3c4d5e6f78
EMAIL_FROM=noreply@mixersstore-dev.com
EMAIL_FROM_NAME=Mixersstore Dev
EMAIL_REPLY_TO=support@mixersstore-dev.com

# Для разработки без реальной отправки emails:
# EMAIL_TRANSPORT=mock # mock, smtp, sendgrid

# ========================
# ЗАГРУЗКА ФАЙЛОВ
# ========================
MAX_FILE_SIZE=5242880 # 5MB в байтах
UPLOAD_PATH=./public/uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,webp,gif
MAX_FILE_COUNT=10
UPLOAD_TEMP_DIR=./temp/uploads

# Cloudinary для продакшена (опционально)
# CLOUDINARY_CLOUD_NAME=dev-cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# ========================
# КЭШИРОВАНИЕ (Redis)
# ========================
# Локальный Redis (Docker: docker run -p 6379:6379 redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

CACHE_TTL=3600 # 1 час в секундах
SESSION_TTL=86400 # 24 часа для сессий
CACHE_ENABLED=false # В разработке отключаем кэш

# ========================
# ПЛАТЕЖНАЯ СИСТЕМА (тестовые ключи)
# ========================
# Stripe Test Keys (получить на dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_51PABC1234567890abcdefghijklmnopqrstuvwxyz012345
STRIPE_SECRET_KEY=sk_test_51PABC1234567890abcdefghijklmnopqrstuvwxyz012345
STRIPE_WEBHOOK_SECRET=whsec_test_1234567890abcdef
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# ЮMoney (Яндекс.Касса) Test Keys
YOOMONEY_SHOP_ID=123456
YOOMONEY_SECRET_KEY=test_abcdefghijklmnopqrstuvwxyz
YOOMONEY_REDIRECT_URL=http://localhost:5173/payment/callback

# ========================
# ЛОГИРОВАНИЕ
# ========================
LOG_LEVEL=debug # error, warn, info, debug, verbose
LOG_FILE=./logs/development.log
LOG_FORMAT=combined # combined, common, dev, short, tiny
ENABLE_REQUEST_LOGGING=true
ENABLE_SQL_LOGGING=true
LOG_SQL_QUERIES=true
LOG_REQUESTS_TO_CONSOLE=true

# ========================
# АНАЛИТИКА И МОНИТОРИНГ
# ========================
# Google Analytics (тестовый)
GOOGLE_ANALYTICS_ID=UA-12345678-9

# Sentry для отслеживания ошибок (DSN для dev)
SENTRY_DSN=https://abcdef1234567890abcdef1234567890@o123456.ingest.sentry.io/1234567

# New Relic (опционально)
NEW_RELIC_LICENSE_KEY=dev_license_key
NEW_RELIC_APP_NAME=Ecommerce Dev

# ========================
# БЕЗОПАСНОСТЬ
# ========================
RATE_LIMIT_WINDOW_MS=900000 # 15 минут в мс
RATE_LIMIT_MAX_REQUESTS=100 # макс запросов за период
ENABLE_CSRF=false # в разработке отключаем для удобства
ENABLE_HELMET=true
ENABLE_CSP=false # Content Security Policy
ENABLE_HSTS=false

# API ключи для внешних сервисов
GOOGLE_MAPS_API_KEY=AIzaSyABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890

# ========================
# РЕЖИМ ОТЛАДКИ
# ========================
DEBUG=true
DEBUG_DATABASE=true
DEBUG_AUTH=true
DEBUG_EMAIL=true
DEBUG_PAYMENT=true
ENABLE_SEEDING=true # автоматическое заполнение тестовыми данными
ENABLE_MIGRATIONS=true # автоматическое применение миграций
ENABLE_DB_LOGGING=true

# ========================
# ПУТИ И ДИРЕКТОРИИ
# ========================
ROOT_PATH=./
UPLOAD_DIR=public/uploads
TEMP_DIR=temp
BACKUP_DIR=backups
LOG_DIR=logs
CACHE_DIR=.cache

# ========================
# СЕССИИ
# ========================
SESSION_SECRET=dev_session_secret_1234567890_change_me_please
SESSION_COOKIE_NAME=ecommerce_dev_sid
SESSION_COOKIE_MAX_AGE=86400000 # 24 часа
SESSION_STORE=memory # memory, redis, database
SESSION_SECURE=false # true только для HTTPS
SESSION_HTTP_ONLY=true

# ========================
# ТЕСТОВЫЕ ПОЛЬЗОВАТЕЛИ
# ========================
# Эти учетки будут созданы при сидировании базы
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=Admin123!
TEST_ADMIN_NAME=Администратор
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=User123!
TEST_USER_NAME=Тестовый Пользователь
TEST_CUSTOMER_EMAIL=customer@example.com
TEST_CUSTOMER_PASSWORD=Customer123!

# ========================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ========================
TIMEZONE=Europe/Moscow
DEFAULT_CURRENCY=RUB
DEFAULT_LANGUAGE=ru
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_SORT=createdAt
DEFAULT_SORT_ORDER=DESC

# ========================
# ДОКУМЕНТАЦИЯ API
# ========================
ENABLE_SWAGGER=true # доступ к Swagger UI по /api-docs
SWAGGER_URL=/api-docs
SWAGGER_TITLE=Ecommerce API Dev
SWAGGER_DESCRIPTION=Development API documentation
SWAGGER_VERSION=1.0.0

ENABLE_GRAPHQL=false # отключаем GraphQL в разработке
GRAPHQL_URL=/graphql
GRAPHQL_PLAYGROUND=true

# ========================
# ОЧЕРЕДИ И ФОНОВЫЕ ЗАДАЧИ
# ========================
ENABLE_QUEUES=false
QUEUE_CONNECTION=redis # redis, database, sync
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1

# ========================
# ПОИСК И ИНДЕКСАЦИЯ
# ========================
SEARCH_ENABLED=false
SEARCH_PROVIDER=database # database, elastic, algolia
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=ecommerce_dev

# ========================
# ВЕБСОКЕТЫ
# ========================
WEBSOCKET_ENABLED=false
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/ws

# ========================
# РАЗНОЕ
# ========================
APP_VERSION=1.0.0-dev
BUILD_NUMBER=20241217.1
SUPPORT_EMAIL=dev-support@ecommerce.dev
SUPPORT_PHONE=+79990001122
COMPANY_NAME=Ecommerce Dev Company
TERMS_URL=http://localhost:5173/terms
PRIVACY_URL=http://localhost:5173/privacy

# ========================
# КОНТЕНТ И SEO
# ========================
SITE_TITLE=Ecommerce Dev Store
SITE_DESCRIPTION=Лучший магазин для разработки
SITE_KEYWORDS=ecommerce,dev,shop,online
SITE_AUTHOR=Ecommerce Team
META_ROBOTS=noindex,nofollow # для dev среды

# ========================
# СИСТЕМНЫЕ НАСТРОЙКИ
# ========================
APP_TIMEZONE=UTC
DB_TIMEZONE=UTC
ENABLE_COMPRESSION=true
ENABLE_ETAG=true
MAX_REQUEST_BODY_SIZE=10mb
MAX_REQUEST_URL_SIZE=1mb

# ========================
# ТЕСТИРОВАНИЕ
# ========================
TEST_TIMEOUT=30000
TEST_DATABASE_URL=postgresql://postgres:test2026@localhost:5433/ecommerce_test
ENABLE_TEST_USER_CREATION=true